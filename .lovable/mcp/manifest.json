{
  "version": 1,
  "sdk_version": "0.22.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://ykyvsbckzglvcpeovjtw.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "sql-workbench-mcp",
      "version": "0.1.0",
      "title": "SQL Workbench MCP"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Who am I",
        "description": "Return the signed-in user's id and email as seen by the MCP server.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_snippets",
        "title": "List SQL snippets",
        "description": "List the signed-in user's saved SQL snippets from the workbench.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "description": "Max number of snippets to return (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "engine": {
              "description": "Filter by engine.",
              "type": "string",
              "enum": [
                "sqlite",
                "postgres",
                "alasql"
              ]
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "save_snippet",
        "title": "Save SQL snippet",
        "description": "Create a new SQL snippet in the signed-in user's workbench.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200,
              "description": "Snippet display name."
            },
            "sql": {
              "type": "string",
              "minLength": 1,
              "description": "SQL body."
            },
            "engine": {
              "default": "sqlite",
              "type": "string",
              "enum": [
                "sqlite",
                "postgres",
                "alasql"
              ]
            },
            "tags": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "name",
            "sql"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "delete_snippet",
        "title": "Delete SQL snippet",
        "description": "Delete a SQL snippet owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Snippet id to delete."
            }
          },
          "required": [
            "id"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_shared_queries",
        "title": "List shared queries",
        "description": "List shared/public SQL queries owned by the signed-in user.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          }
        },
        "outputSchema": null
      },
      {
        "name": "list_history",
        "title": "List query history",
        "description": "List the signed-in user's recent SQL execution history.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            },
            "status": {
              "type": "string",
              "enum": [
                "ok",
                "error"
              ]
            }
          }
        },
        "outputSchema": null
      }
    ]
  }
}
